{
  "name": "homebridge-mertik-wifi-fireplace",
  "displayName": "Mertik WiFi Fireplace",
  "type": "module",
  "version": "1.0.0",
  "description": "Reliable HomeKit control for Mertik Maxitrol WiFi gas fireplaces: verified on/off, flame height, boost burner, thermostat, child lock, and shutdown-failure and left-on alerts.",
  "author": "Andrew Byrne",
  "license": "Apache-2.0",
  "homepage": "https://github.com/andybyrne55/homebridge-mertik-wifi-fireplace#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andybyrne55/homebridge-mertik-wifi-fireplace.git"
  },
  "bugs": {
    "url": "https://github.com/andybyrne55/homebridge-mertik-wifi-fireplace/issues"
  },
  "keywords": [
    "homebridge-plugin",
    "supports-hap",
    "homebridge",
    "homekit",
    "mertik",
    "maxitrol",
    "fireplace",
    "gas fire"
  ],
  "main": "dist/index.js",
  "files": [
    "dist",
    "config.schema.json",
    "LICENSE",
    "NOTICE",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || ^26.0.0",
    "homebridge": "^1.8.0 || ^2.0.0"
  },
  "scripts": {
    "build": "rimraf ./dist && tsc",
    "build:test": "rimraf ./dist-test && tsc -p tsconfig.test.json",
    "lint": "eslint . --max-warnings=0",
    "test": "npm run build:test && node --test --test-concurrency=1 \"dist-test/test/**/*.test.js\"",
    "prepublishOnly": "npm run lint && npm run build",
    "watch": "npm run build && npm link && nodemon",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "eslint": "^10.9.0",
    "homebridge": "^2.4.0",
    "nodemon": "^3.1.14",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  }
}
